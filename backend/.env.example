# Server Configuration
PORT=5000
NODE_ENV=production
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3001

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/janmitra?retryWrites=true&w=majority

# Security
JWT_SECRET=your_super_secret_jwt_key_here

# Cloudinary (Optional - file upload fallback uses memory storage if absent)
